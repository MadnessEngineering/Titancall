#!/usr/bin/env bash
# titancall — Titanfall 2 audio notification router
# Pipe any project/hook into this: `titancall done &`  → this project's Titan speaks a fitting line.
set -uo pipefail

# resolve repo dir through the ~/.local/bin symlink so we can find data/buckets.tsv
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do _d=$(cd -P "$(dirname "$_src")" && pwd); _src=$(readlink "$_src"); [[ "$_src" != /* ]] && _src="$_d/$_src"; done
REPO_DIR="$(cd -P "$(dirname "$_src")/.." && pwd)"
MANIFEST="$REPO_DIR/data/buckets.tsv"   # authoritative titan\tslug\tbucket (from scripts/build_manifest.py)

TITANCALL_HOME="${TITANCALL_HOME:-$HOME/.local/share/titancall}"
SOUNDS="$TITANCALL_HOME/sounds"
STATE="$TITANCALL_HOME/state"        # per-titan last-fired epoch for cooldown
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/titancall"
CONFIG="$CONFIG_DIR/config"
REGISTRY="$CONFIG_DIR/registry"      # rows: titan \t project_path \t last_fired_iso
ACTIVE_SRC=""                        # set by resolve_titan: env|dotfile|registry|claimed|config
ACTIVE_TITAN=""

# ---- event taxonomy: bucket <= ordered keyword rules (first match wins) ----
BUCKET_RULES=(
  "eject|eject"
  "core|core"
  "down|titan down|titan destroyed|pilot eliminated|pilot eleminated|pilot destroyed|got you|enemy titan down"
  "damage|critical damage|heavy damage|compromised|comprimised|casing|reactor|vun"
  "warn|warning|be aware|outnumbered|multititan|position compromised|postion compromised|on the hull"
  "enter|pilot control|pilot mode online|pilot mode onlien|pilot mode engaged|controls handed|controls are handed|transfering|transfered|tranfered|manual control|manual operation|have you back|good you returned|onboard|systems nominal|all systems"
  "guard|gaurd mode|guard mode|gaurdmode"
  "follow|follow mode|folow mode|following your lead|solid copy|your lead pilot"
  "attack|engaging|armed|charged|railgun|targeting|40mm|splinter rifle|powering up|weapon|wepond|sensors scanning|focus|plan attack"
  "exit|disengage|offline"
)

# ---- bucket degradation: <bucket>|<next>|<next>... — walked when a voice has no wavs for a bucket.
# Voices are ripped by ear, so coverage is uneven and always will be (a stranger's library more so).
# Order each chain by *nearest meaning*, so a thin voice degrades to a wrong-but-plausible line
# rather than dying. `misc` and then any-wav-at-all are appended implicitly by playable_bucket.
BUCKET_FALLBACK=(
  "down|core|attack"       # a kill/finish -> triumphant, else aggressive
  "core|down|attack"
  "eject|damage|warn"      # fatal -> the most alarmed thing on hand
  "damage|warn|eject"
  "warn|damage|guard"
  "enter|follow|guard"     # session start -> any "I'm with you" line
  "follow|guard|enter"
  "attack|core|enter"
  "guard|follow|enter"
  "exit|guard|follow|down"
)

DEFAULT_CONFIG='enabled=1
titan=ion
output=
volume=0.7
cooldown=4
loudness=-18
claim=1
log=1
# logical event -> bucket (hooks speak dev-words, not titan-words)
alias.done=down
alias.success=core
alias.error=damage
alias.fatal=eject
alias.warn=warn
alias.start=enter
alias.notify=follow
alias.working=attack
alias.idle=guard'

err()  { printf 'titancall: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

ensure_config() { [ -f "$CONFIG" ] && return 0; mkdir -p "$CONFIG_DIR"; printf '%s\n' "$DEFAULT_CONFIG" > "$CONFIG"; }

_OVERLAY=""; _OVERLAY_RESOLVED=""
overlay_path() { # memoized: this project's .titan (config overlay), or empty. cfg reads it first.
  [ -n "$_OVERLAY_RESOLVED" ] && { printf '%s' "$_OVERLAY"; return; }
  _OVERLAY_RESOLVED=1; local d; d=$(find_dotfile_dir) && _OVERLAY="$d/.titan"; printf '%s' "$_OVERLAY"
}

cfg() { # key [default] — project .titan overlay wins over global CONFIG. Skip the bare titan line.
  local k="$1" d="${2:-}" ov v
  ov=$(overlay_path)
  [ -n "$ov" ] && v=$(grep -E "^${k}=" "$ov" 2>/dev/null | head -1 | cut -d= -f2-)
  [ -z "${v:-}" ] && v=$(grep -E "^${k}=" "$CONFIG" 2>/dev/null | head -1 | cut -d= -f2-)
  [ -n "${v:-}" ] && printf '%s' "$v" || printf '%s' "$d"
}

cfg_set() {
  local k="$1" v="$2" tmp; ensure_config; tmp="$CONFIG.tmp.$$"
  if grep -qE "^${k}=" "$CONFIG"; then sed "s|^${k}=.*|${k}=${v}|" "$CONFIG" > "$tmp" && mv "$tmp" "$CONFIG"
  else cp "$CONFIG" "$tmp" && printf '%s=%s\n' "$k" "$v" >> "$tmp" && mv "$tmp" "$CONFIG"; fi
}

cfg_unset() { # drop a key entirely (atomic like cfg_set); no-op when absent
  local k="$1" tmp; [ -f "$CONFIG" ] || return 0; tmp="$CONFIG.tmp.$$"
  { grep -vE "^${k}=" "$CONFIG" || true; } > "$tmp" && mv "$tmp" "$CONFIG"
}

slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/\.wav$//; s/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'; }

manifest_bucket() { # titan slug -> curated bucket from data/buckets.tsv, or nothing
  [ -f "$MANIFEST" ] || return 1
  awk -F'\t' -v t="$1" -v s="$2" '$1==t && $2==s {print $3; f=1} END{exit !f}' "$MANIFEST"
}

classify() {
  local name="$1" rule bucket pats pat
  for rule in "${BUCKET_RULES[@]}"; do
    bucket="${rule%%|*}"; pats="${rule#*|}"
    local IFS='|'; read -ra arr <<< "$pats"
    for pat in "${arr[@]}"; do [[ "$name" == *"$pat"* ]] && { printf '%s' "$bucket"; return 0; }; done
  done
  printf 'misc'
}

list_titans() { find "$SOUNDS" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sort; }

# ---- project identity + registry ----
find_dotfile_dir() {
  local d="${1:-$PWD}"
  while [ -n "$d" ] && [ "$d" != "/" ]; do
    [ -f "$d/.titan" ] && { printf '%s' "$d"; return 0; }
    d=$(dirname "$d")
  done
  return 1
}
# .titan format: first non-blank/non-# line WITHOUT '=' is the titan; k=v lines are the config overlay.
read_dotfile() { # -> titan name from nearest .titan, or rc 1
  local d f; d=$(find_dotfile_dir "${1:-$PWD}") || return 1; f="$d/.titan"
  awk '/^[[:space:]]*#/ || /^[[:space:]]*$/ {next} /=/ {next} {gsub(/[[:space:]]/,"",$0); print; exit}' "$f"
}

dotfile_target() { # path to the .titan we should WRITE — existing one, else at project_root
  local d; d=$(find_dotfile_dir) && { printf '%s/.titan' "$d"; return; }
  printf '%s/.titan' "$(project_root)"
}
dotfile_titan() { # titan token currently in a .titan file (empty if none)
  [ -f "$1" ] || return 0
  awk '/^[[:space:]]*#/ || /^[[:space:]]*$/ {next} /=/ {next} {gsub(/[[:space:]]/,"",$0); print; exit}' "$1"
}
dotfile_overlay_lines() { # the k=v overlay lines of a .titan (no titan token, no blanks/comments)
  [ -f "$1" ] || return 0
  grep -E '^[[:space:]]*[A-Za-z0-9_.-]+=' "$1" 2>/dev/null | grep -vE '^[[:space:]]*titan=' || true
}
dotfile_write_titan() { # name path — set/replace titan token, PRESERVE overlay k=v lines. atomic.
  local name="$1" path="$2" tmp="$2.tmp.$$"
  { printf '%s\n' "$name"; [ -f "$path" ] && dotfile_overlay_lines "$path"; } > "$tmp" && mv "$tmp" "$path"
}
dotfile_set() { # key val — set overlay entry in this project's .titan, preserving titan line. atomic.
  local k="$1" v="$2" f t tmp; f=$(dotfile_target); tmp="$f.tmp.$$"
  t=$(dotfile_titan "$f"); [ -n "$t" ] || t=$(active_titan)
  { printf '%s\n' "$t"; { dotfile_overlay_lines "$f" | grep -vE "^${k}="; printf '%s=%s\n' "$k" "$v"; }; } > "$tmp" && mv "$tmp" "$f"
}
dotfile_unset() { # key — drop an overlay entry; no-op when absent
  local k="$1" f t tmp; f=$(dotfile_target); [ -f "$f" ] || return 0; tmp="$f.tmp.$$"
  t=$(dotfile_titan "$f")
  { printf '%s\n' "$t"; dotfile_overlay_lines "$f" | { grep -vE "^${k}=" || true; }; } > "$tmp" && mv "$tmp" "$f"
}

project_root() {
  local d
  if [ -n "${CLAUDE_PROJECT_DIR:-}" ] && [ -d "$CLAUDE_PROJECT_DIR" ]; then printf '%s' "$CLAUDE_PROJECT_DIR"; return; fi
  d=$(find_dotfile_dir) && { printf '%s' "$d"; return; }
  d=$(git rev-parse --show-toplevel 2>/dev/null) && [ -n "$d" ] && { printf '%s' "$d"; return; }
  printf '%s' "$PWD"
}

reg_lookup() { [ -f "$REGISTRY" ] || return 1; awk -F'\t' -v p="$1" '$2==p{print $1; f=1} END{exit !f}' "$REGISTRY"; }
reg_used()   { [ -f "$REGISTRY" ] || return 0; awk -F'\t' '{print $1}' "$REGISTRY" | sort -u; }
reg_write()  {
  local titan="$1" path="$2" now tmp; now=$(date +%Y-%m-%dT%H:%M:%S)
  mkdir -p "$CONFIG_DIR"; touch "$REGISTRY"; tmp="$REGISTRY.tmp.$$"
  awk -F'\t' -v p="$path" '$2!=p' "$REGISTRY" > "$tmp"
  printf '%s\t%s\t%s\n' "$titan" "$path" "$now" >> "$tmp"; mv "$tmp" "$REGISTRY"
}
reg_touch()  { # path [titan] — refresh this path's row. The ACTIVE titan is authoritative: a `.titan`
  # outranks the registry in resolve_titan, so looking the titan up BY PATH would keep re-stamping a
  # stale row and the real owner would never get one (registry silently tracking a ghost).
  local t="${2:-}"; [ -n "$t" ] || t=$(reg_lookup "$1") || return 1; reg_write "$t" "$1"; }
reg_paths()  { [ -f "$REGISTRY" ] || return 0; awk -F'\t' 'NF{print $2}' "$REGISTRY"; }
reg_rows()   { # field value -> full rows whose field N equals value
  [ -f "$REGISTRY" ] || return 0; awk -F'\t' -v n="$1" -v v="$2" '$n==v' "$REGISTRY"; }
reg_forget() { # <titan|""> path... -> remove those rows (atomic); rc 1 if nothing matched.
  # empty titan = every row for the path; otherwise only the titan+path row.
  [ -f "$REGISTRY" ] || return 1
  local t="$1"; shift
  local tmp="$REGISTRY.tmp.$$" p before after
  before=$(wc -l < "$REGISTRY")
  cp "$REGISTRY" "$tmp"
  for p in "$@"; do
    awk -F'\t' -v p="$p" -v t="$t" '!($2==p && (t=="" || $1==t))' "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"
  done
  after=$(wc -l < "$tmp")
  mv "$tmp" "$REGISTRY"
  [ "$before" -gt "$after" ]
}

LOGFILE="$TITANCALL_HOME/log"        # rows: iso \t event \t titan \t bucket \t wav \t project_path
log_play() { # event titan bucket wav_path project_path — append one row, or nothing when log=0
  [ "$(cfg log 1)" = "0" ] && return 0
  mkdir -p "$TITANCALL_HOME"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$1" "$2" "$3" "$(basename "$4")" "$5" >> "$LOGFILE"
}

claim_titan() { # path -> next unused titan (else least-used), persist .titan + registry
  local path="$1" all=() used t chosen=""
  while IFS= read -r t; do all+=("$t"); done < <(list_titans)
  [ ${#all[@]} -eq 0 ] && return 1
  used=$(reg_used)
  for t in "${all[@]}"; do grep -qxF "$t" <<<"$used" || { chosen="$t"; break; }; done
  if [ -z "$chosen" ]; then
    chosen=$(awk -F'\t' '{c[$1]++} END{for(k in c) print c[k]"\t"k}' "$REGISTRY" | sort -n | head -1 | cut -f2)
    [ -z "$chosen" ] && chosen="${all[0]}"
  fi
  reg_write "$chosen" "$path"
  [ -d "$path" ] && dotfile_write_titan "$chosen" "$path/.titan" 2>/dev/null
  printf '%s' "$chosen"
}

resolve_titan() { # sets globals ACTIVE_TITAN + ACTIVE_SRC (run in current shell, no subshell)
  local t proot
  if [ -n "${TITANCALL_TITAN:-}" ]; then ACTIVE_TITAN="$TITANCALL_TITAN"; ACTIVE_SRC="env"; return; fi
  if t=$(read_dotfile) && [ -n "$t" ]; then ACTIVE_TITAN="$t"; ACTIVE_SRC="dotfile"; return; fi
  proot=$(project_root)
  if t=$(reg_lookup "$proot") && [ -n "$t" ]; then ACTIVE_TITAN="$t"; ACTIVE_SRC="registry"; return; fi
  if [ "$(cfg claim 1)" != "0" ] && t=$(claim_titan "$proot") && [ -n "$t" ]; then ACTIVE_TITAN="$t"; ACTIVE_SRC="claimed"; return; fi
  ACTIVE_TITAN=$(cfg titan ion); ACTIVE_SRC="config"
}
active_titan() { resolve_titan; printf '%s' "$ACTIVE_TITAN"; }

# ---- audio output (macOS SwitchAudioSource) ----
have_switch() { command -v SwitchAudioSource >/dev/null 2>&1; }
play_file() {
  # Non-blocking: playback is detached (own subshell, fds closed) so titancall returns
  # immediately and the sound finishes orphaned — hooks never wait on it.
  # Set TITANCALL_WAIT=1 to block until the clip finishes (handy for scripting/tests).
  local f="$1" event="${2:-}" vol output    # event optional: volume.<event> overrides global volume
  vol=$([ -n "$event" ] && cfg "volume.$event" "$(cfg volume 0.7)" || cfg volume 0.7); output=$(cfg output "")
  command -v afplay >/dev/null 2>&1 || die "afplay not found (macOS only for now)"
  [ -n "$output" ] && ! have_switch && err "output '$output' set but SwitchAudioSource missing; using default device"
  if [ "${TITANCALL_WAIT:-0}" = "1" ]; then
    _play_seq "$f" "$vol" "$output"
  else
    ( _play_seq "$f" "$vol" "$output" ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
}

_play_seq() { # f vol output  — switch device if set, play, restore. Blocks (caller decides).
  local f="$1" vol="$2" output="$3" prev
  if [ -n "$output" ] && have_switch; then
    prev=$(SwitchAudioSource -c -t output 2>/dev/null)
    SwitchAudioSource -t output -s "$output" >/dev/null 2>&1
    afplay -v "$vol" "$f"
    [ -n "$prev" ] && SwitchAudioSource -t output -s "$prev" >/dev/null 2>&1
  else
    afplay -v "$vol" "$f"
  fi
}

group_buckets() { # name -> newline-separated members of group.<name>, or nothing (rc 1)
  local g; g=$(cfg "group.$1" ""); [ -n "$g" ] || return 1
  printf '%s' "$g" | tr ',' '\n' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | grep -v '^$'
}

resolve_bucket() { # event [titan] -> bucket
  # alias.<event> may name a bucket OR a group.<name>; a group resolves to one random member.
  # With a titan, group members are narrowed to those that actually hold wavs for that voice.
  local ev="$1" titan="${2:-}" a target members=() live=() b
  a=$(cfg "alias.$ev" ""); target="${a:-$ev}"
  while IFS= read -r b; do members+=("$b"); done < <(group_buckets "$target")
  [ ${#members[@]} -eq 0 ] && { printf '%s' "$target"; return; }
  if [ -n "$titan" ]; then
    for b in "${members[@]}"; do
      [ -n "$(find "$SOUNDS/$titan/$b" -maxdepth 1 -iname '*.wav' -print -quit 2>/dev/null)" ] && live+=("$b")
    done
    [ ${#live[@]} -gt 0 ] && members=("${live[@]}")
  fi
  printf '%s' "${members[$(( RANDOM % ${#members[@]} ))]}"
}
bucket_has_wavs() { # titan bucket
  [ -n "$(find "$SOUNDS/$1/$2" -maxdepth 1 -iname '*.wav' -print -quit 2>/dev/null)" ]
}

playable_bucket() { # titan bucket -> first bucket in its degradation chain that holds wavs (rc 1 if
  # the voice has no wavs at all). Callers log/pick the RESULT, so the log records what really played.
  local titan="$1" want="$2" rule chain b
  bucket_has_wavs "$titan" "$want" && { printf '%s' "$want"; return 0; }
  for rule in "${BUCKET_FALLBACK[@]}"; do
    [ "${rule%%|*}" = "$want" ] || continue
    local IFS='|'; read -ra chain <<< "${rule#*|}"
    for b in "${chain[@]}"; do
      bucket_has_wavs "$titan" "$b" && { printf '%s' "$b"; return 0; }
    done
    break
  done
  bucket_has_wavs "$titan" misc && { printf '%s' misc; return 0; }
  # last resort: any bucket this voice does have, so a sparse library still speaks
  b=$(find "$SOUNDS/$titan" -mindepth 2 -maxdepth 2 -iname '*.wav' -print -quit 2>/dev/null) || return 1
  [ -n "$b" ] || return 1
  b=$(dirname "$b"); printf '%s' "${b##*/}"
}

pick_wav() {
  local titan="$1" bucket="$2" files=() pick f dir
  dir="$SOUNDS/$titan/$bucket"
  [ -d "$dir" ] || return 1
  while IFS= read -r f; do files+=("$f"); done < <(find "$dir" -maxdepth 1 -iname '*.wav' 2>/dev/null)
  [ ${#files[@]} -eq 0 ] && return 1
  pick=$(( RANDOM % ${#files[@]} )); printf '%s' "${files[$pick]}"
}

# ---- subcommands ----
cooldown_ok() { # titan [event] -> 0 if allowed to play now (and stamps), 1 if within cooldown
  local titan="$1" event="${2:-}" cd now last sf    # event optional: cooldown.<event> overrides global cooldown
  cd=$([ -n "$event" ] && cfg "cooldown.$event" "$(cfg cooldown 4)" || cfg cooldown 4)
  [ "$cd" -gt 0 ] 2>/dev/null || return 0
  mkdir -p "$STATE"; sf="$STATE/$titan.last"
  now=$(date +%s); last=$(cat "$sf" 2>/dev/null || echo 0)
  [ $(( now - last )) -lt "$cd" ] && return 1
  echo "$now" > "$sf"; return 0
}

cmd_play() {
  [ "$(cfg enabled 1)" = "0" ] && return 0     # global mute gate (hooks call us anyway, stay quiet)
  local event="${1:-notify}" titan bucket f proot
  titan=$(active_titan)
  [ -d "$SOUNDS/$titan" ] || die "titan '$titan' has no voice folder (titancall titan list)"
  cooldown_ok "$titan" "$event" || return 0    # per-voice cooldown: collapse bursts (e.g. SubagentStop)
  bucket=$(resolve_bucket "$event" "$titan")
  bucket=$(playable_bucket "$titan" "$bucket") || die "titan '$titan' has no wavs at all"
  f=$(pick_wav "$titan" "$bucket") || die "no audio for '$event' (bucket '$bucket') in '$titan'"
  proot=$(project_root)
  reg_touch "$proot" "$titan" 2>/dev/null
  log_play "$event" "$titan" "$bucket" "$f" "$proot"
  play_file "$f" "$event"
}

confirm() { # titan event — immediate confirmation chirp: respects mute, ignores cooldown, detached
  [ "$(cfg enabled 1)" = "0" ] && return 0
  local titan="$1" event="$2" f
  [ -d "$SOUNDS/$titan" ] || return 0
  local b; b=$(playable_bucket "$titan" "$(resolve_bucket "$event" "$titan")") || return 0
  f=$(pick_wav "$titan" "$b") || return 0
  ( play_file "$f" >/dev/null 2>&1 & )
}

cmd_random() {
  local event="${1:-notify}" titans=() titan bucket f
  while IFS= read -r t; do titans+=("$t"); done < <(list_titans)
  [ ${#titans[@]} -eq 0 ] && die "no titans installed"
  titan="${titans[$(( RANDOM % ${#titans[@]} ))]}"
  bucket=$(resolve_bucket "$event" "$titan")
  bucket=$(playable_bucket "$titan" "$bucket") || die "titan '$titan' has no wavs at all"
  f=$(pick_wav "$titan" "$bucket") || die "no audio for '$event' across titans"
  err "($titan)"
  log_play "random:$event" "$titan" "$bucket" "$f" "$(project_root)"
  play_file "$f"
}

cmd_whoami() {
  resolve_titan
  echo "titan:   $ACTIVE_TITAN  (via $ACTIVE_SRC)"
  echo "project: $(project_root)"
  local ov n; ov=$(overlay_path)
  if [ -n "$ov" ] && [ -f "$ov" ]; then
    n=$(dotfile_overlay_lines "$ov" | grep -c . || true)
    [ "${n:-0}" -gt 0 ] && echo "overlay: $ov  ($n override$([ "$n" = 1 ] || echo s))"
  fi
}

cmd_roster() {
  case "${1:-list}" in
    list|"")
      [ -f "$REGISTRY" ] && [ -s "$REGISTRY" ] || { echo "(registry empty)"; return; }
      { printf 'TITAN\tPROJECT\tLAST_FIRED\n'; sort -k1,1 "$REGISTRY"; } | column -t -s "$(printf '\t')" ;;
    prune)  shift; roster_prune "$@" ;;
    forget) shift; roster_forget "$@" ;;
    *) die "usage: titancall roster [prune [-n] | forget [<path>|<titan>]]" ;;
  esac
}

roster_prune() { # drop every row whose project dir is gone. -n/--dry-run to preview.
  local dry=0; case "${1:-}" in -n|--dry-run) dry=1 ;; "") ;; *) die "usage: titancall roster prune [-n]" ;; esac
  [ -f "$REGISTRY" ] && [ -s "$REGISTRY" ] || { echo "(registry empty)"; return; }
  local gone=() titan path rest
  while IFS=$'\t' read -r titan path rest; do
    [ -n "${path:-}" ] || continue
    [ -d "$path" ] || { gone+=("$path"); printf '%s  %s\t%s\n' "$([ "$dry" = 1 ] && echo would-drop || echo dropped)" "$titan" "$path"; }
  done < "$REGISTRY"
  [ ${#gone[@]} -eq 0 ] && { echo "nothing to prune ($(wc -l < "$REGISTRY" | tr -d ' ') rows, all present)"; return; }
  [ "$dry" = 1 ] && return 0
  reg_forget "" "${gone[@]}" && echo "pruned ${#gone[@]} row(s) — those titans are free again"
}

roster_forget() { # [--purge] <path> | <titan> | (bare = current project) -> remove that row
  local purge=0
  case "${1:-}" in --purge|-p) purge=1; shift ;; esac
  local arg="${1:-}" path="" titan="" rows n
  if [ -z "$arg" ]; then path=$(project_root)
  elif [ -d "$arg" ] || [ "${arg:0:1}" = / ] || [ "${arg:0:1}" = . ]; then
    path=$(cd "$arg" 2>/dev/null && pwd) || path="${arg%/}"
  else
    rows=$(reg_rows 1 "$arg"); n=$(printf '%s' "$rows" | grep -c . || true)
    [ "${n:-0}" -eq 0 ] && die "no registry row for titan '$arg' (titancall roster)"
    if [ "$n" -gt 1 ]; then
      err "titan '$arg' holds $n projects — name the path:"
      printf '%s\n' "$rows" | cut -f2 | sed 's/^/  /' >&2; exit 2
    fi
    titan="$arg"; path=$(printf '%s' "$rows" | cut -f2)
  fi
  local shown="$titan"                          # titan="" => drop every row for that path
  [ -n "$shown" ] || shown=$(reg_lookup "$path" | paste -sd, -) || die "not in registry: $path"
  reg_forget "$titan" "$path" || die "not in registry: $path"
  echo "forgot $shown -> $path"
  if [ -f "$path/.titan" ]; then
    if [ "$purge" = 1 ]; then
      # keep any per-project overlay (aliases/groups) — only the identity line goes
      local ov; ov=$(dotfile_overlay_lines "$path/.titan")
      if [ -n "$ov" ]; then
        printf '%s\n' "$ov" > "$path/.titan.tmp.$$" && mv "$path/.titan.tmp.$$" "$path/.titan"
        echo "purged the titan line; kept $(printf '%s\n' "$ov" | grep -c .) overlay line(s) in $path/.titan"
      else
        rm -f "$path/.titan"; echo "removed $path/.titan"
      fi
      [ -d "$path/.git" ] && echo "note: .titan may be tracked — check 'git status' in $path"
    else
      echo "note: $path/.titan still pins '$shown' — it re-registers on next fire (--purge to drop it too)"
    fi
  fi
  return 0
}

cmd_titan() {
  case "${1:-show}" in
    list)    list_titans ;;
    show|"") cmd_whoami ;;
    here)
      shift; [ -n "${1:-}" ] || die "usage: titancall titan here <name>"
      [ -d "$SOUNDS/$1" ] || die "unknown titan '$1' (titancall titan list)"
      local root; root=$(project_root); dotfile_write_titan "$1" "$root/.titan"; reg_write "$1" "$root"
      echo "registered $root as titan: $1"; confirm "$1" enter ;;
    *)
      [ -d "$SOUNDS/$1" ] || die "unknown titan '$1' (titancall titan list)"
      cfg_set titan "$1"; echo "default titan: $1"; confirm "$1" enter ;;
  esac
}

cmd_output() {
  case "${1:-list}" in
    list|"") have_switch || die "brew install switchaudio-osx"; SwitchAudioSource -a -t output ;;
    default) cfg_set output ""; echo "output: system default"; confirm "$(active_titan)" notify ;;
    *) cfg_set output "$1"; echo "output: $1"; confirm "$(active_titan)" notify ;;   # chirps on the NEW device
  esac
}

cmd_volume() { [ -n "${1:-}" ] && { cfg_set volume "$1"; echo "volume: $1"; confirm "$(active_titan)" notify; } || echo "volume: $(cfg volume 0.7)"; }
cmd_cooldown() { [ -n "${1:-}" ] && { cfg_set cooldown "$1"; echo "cooldown: ${1}s per voice"; } || echo "cooldown: $(cfg cooldown 4)s per voice"; }

cmd_lines() {
  local titan; titan=$(active_titan)
  if [ -n "${1:-}" ]; then
    local b; b=$(resolve_bucket "$1" "$titan"); echo "[$titan/$b]"
    find "$SOUNDS/$titan/$b" -maxdepth 1 -iname '*.wav' -exec basename {} \; 2>/dev/null | sort
  else
    echo "[$titan] buckets:"
    for d in "$SOUNDS/$titan"/*/; do
      [ -d "$d" ] || continue
      printf '  %-8s %s\n' "$(basename "$d")" "$(find "$d" -maxdepth 1 -iname '*.wav' | wc -l | tr -d ' ')"
    done
  fi
}

bucket_names() { local rule; for rule in "${BUCKET_RULES[@]}"; do printf '%s\n' "${rule%%|*}"; done; echo misc; }

group_names() { grep -E '^group\.' "$CONFIG" 2>/dev/null | sed -E 's/^group\.([^=]+)=.*/\1/' | sort; }
target_names() { bucket_names; group_names; }   # everything an alias may point at

list_has() { # needle newline-list -> 0 if an exact line matches
  # No `| grep -q`: grep exits on first match, SIGPIPEs the producer, and pipefail then
  # reports the whole pipeline as failed even though the match succeeded.
  local needle="$1" line
  while IFS= read -r line; do [ "$line" = "$needle" ] && return 0; done <<< "$2"
  return 1
}

CONFIG_KEYS="enabled titan output volume cooldown loudness claim log"
key_ok() { # 0 if key is a known scalar, alias.*, group.*, or per-event volume./cooldown. override
  case "$1" in
    alias.*|volume.*|cooldown.*|group.*) return 0 ;;
    *) case " $CONFIG_KEYS " in *" $1 "*) return 0 ;; *) return 1 ;; esac ;;
  esac
}
cmd_config() {
  ensure_config
  local sub="${1:-}" key="${2:-}"
  case "$sub" in
    "")
      local ov; ov=$(overlay_path)
      if [ -z "$ov" ] || [ ! -f "$ov" ]; then echo "# $CONFIG"; cat "$CONFIG"; return; fi
      echo "# $CONFIG  (+ overlay $ov)   [P]=project [G]=global, project wins"
      { grep -oE '^[A-Za-z0-9_.-]+=' "$CONFIG" 2>/dev/null; dotfile_overlay_lines "$ov" | grep -oE '^[A-Za-z0-9_.-]+='; } \
        | sed 's/=$//' | sort -u | while IFS= read -r k; do
          [ -n "$k" ] || continue
          if dotfile_overlay_lines "$ov" | grep -qE "^${k}="; then printf '%s=%s\t[P]\n' "$k" "$(cfg "$k")"
          else printf '%s=%s\t[G]\n' "$k" "$(cfg "$k")"; fi
        done | column -t -s "$(printf '\t')" ;;
    get) [ -n "$key" ] || die "usage: titancall config get <key>"; cfg "$key"; echo ;;
    set)
      [ -n "$key" ] && [ $# -ge 3 ] || die "usage: titancall config set <key> <val>"
      key_ok "$key" || die "unknown key '$key' (valid: $CONFIG_KEYS, alias.*, volume.*, cooldown.*, group.*)"
      cfg_set "$key" "$3"; echo "$key=$3" ;;
    unset)
      [ -n "$key" ] || die "usage: titancall config unset <key>"
      case "$key" in
        alias.*|volume.*|cooldown.*|group.*) ;;    # only namespaced keys: scalars have defaults to keep
        *) die "refusing to unset '$key' — only alias.*, volume.*, cooldown.*, group.* can be removed" ;;
      esac
      cfg_unset "$key"; echo "unset $key" ;;
    *)   die "usage: titancall config [get <k> | set <k> <v> | unset <k>]" ;;
  esac
}

cmd_alias() { # list alias.* mappings, or set alias.<event>=<bucket|group> (target must be known)
  local event="${1:-}" target="${2:-}" targets
  targets=$(target_names | paste -sd' ' -)
  if [ -z "$event" ]; then
    grep -E '^alias\.' "$CONFIG" 2>/dev/null | sed -E 's/^alias\.([^=]+)=(.*)/\1 -> \2/' | sort
    return 0
  fi
  [ -n "$target" ] || die "usage: titancall alias <event> <bucket|group>   (targets: $targets)"
  list_has "$target" "$(target_names)" || die "unknown target '$target' (valid: $targets)"
  cfg_set "alias.$event" "$target"; echo "alias: $event -> $target"
}

cmd_project() { # per-project config overlay written into this project's .titan (wins over global)
  local sub="${1:-show}" f targets
  case "$sub" in
    show|"")
      f=$(dotfile_target)
      echo "titan:   $(active_titan)"
      echo "overlay: $f"
      if [ -f "$f" ] && dotfile_overlay_lines "$f" | grep -q .; then dotfile_overlay_lines "$f"
      else echo "(no overrides — titancall project alias|group|set ...)"; fi ;;
    alias)
      local event="${2:-}" target="${3:-}"; targets=$(target_names | paste -sd' ' -)
      [ -n "$event" ] && [ -n "$target" ] || die "usage: titancall project alias <event> <bucket|group>   (targets: $targets)"
      list_has "$target" "$(target_names)" || die "unknown target '$target' (valid: $targets)"
      dotfile_set "alias.$event" "$target"; echo "project alias: $event -> $target  ($(dotfile_target))" ;;
    group)
      local name="${2:-}" members="${3:-}" b bad=()
      [ -n "$name" ] && [ -n "$members" ] || die "usage: titancall project group <name> <b1,b2,...>"
      for b in $(printf '%s' "$members" | tr ',' ' '); do list_has "$b" "$(bucket_names)" || bad+=("$b"); done
      [ ${#bad[@]} -eq 0 ] || die "unknown bucket(s): ${bad[*]}"
      dotfile_set "group.$name" "$members"; echo "project group: $name -> $members" ;;
    set)
      local key="${2:-}" val="${3:-}"
      [ -n "$key" ] && [ $# -ge 3 ] || die "usage: titancall project set <key> <val>"
      [ "$key" = titan ] && die "set the project titan with 'titancall titan here <name>'"
      key_ok "$key" || die "unknown key '$key' (valid: $CONFIG_KEYS, alias.*, volume.*, cooldown.*, group.*)"
      dotfile_set "$key" "$val"; echo "project $key=$val" ;;
    unset)
      local key="${2:-}"
      [ -n "$key" ] || die "usage: titancall project unset <key>"
      dotfile_unset "$key"; echo "project unset $key" ;;
    *) die "usage: titancall project [show | alias <e> <t> | group <n> <b,..> | set <k> <v> | unset <k>]" ;;
  esac
}

cmd_group() { # named bucket sets: an alias pointing at a group draws from any member bucket
  ensure_config
  local sub="${1:-list}" name="${2:-}" members b bad=()
  case "$sub" in
    list|"")
      group_names | while IFS= read -r name; do
        [ -n "$name" ] && printf '%-10s %s\n' "$name" "$(cfg "group.$name")"
      done
      group_names | grep -q . || echo "(no groups — titancall group set <name> <b1,b2,...>)" ;;
    show)
      [ -n "$name" ] || die "usage: titancall group show <name>"
      group_buckets "$name" || die "no group '$name'" ;;
    set)
      [ -n "$name" ] && [ $# -ge 3 ] || die "usage: titancall group set <name> <bucket>[,<bucket>...]"
      shift 2; members=$(printf '%s' "$*" | tr ' ' ',' | tr -s ',')      # accept commas or spaces
      local known; known=$(bucket_names)
      list_has "$name" "$known" && die "'$name' is a bucket name — pick another group name"
      while IFS= read -r b; do
        [ -z "$b" ] && continue
        list_has "$b" "$known" || bad+=("$b")
      done < <(printf '%s\n' "$members" | tr ',' '\n')   # trailing \n or `read` drops the last member
      [ ${#bad[@]} -gt 0 ] && die "unknown bucket(s): ${bad[*]}  (valid: $(printf '%s' "$known" | paste -sd' ' -))"
      cfg_set "group.$name" "$members"; echo "group: $name = $members" ;;
    rm|delete)
      [ -n "$name" ] || die "usage: titancall group rm <name>"
      [ -n "$(cfg "group.$name")" ] || die "no group '$name'"
      cfg_unset "group.$name"; echo "removed group: $name"
      # no dangling aliases is the normal case — don't let grep's rc 1 fail the command
      if grep -qE "^alias\.[^=]+=${name}\$" "$CONFIG"; then
        err "note: aliases still point at '$name' (titancall alias)"
      fi ;;
    *) die "usage: titancall group [list | show <name> | set <name> <buckets> | rm <name>]" ;;
  esac
}

cmd_normalize() {
  local titan_dir f base bucket slug dest n moved=0
  for titan_dir in "$SOUNDS"/*/; do
    [ -d "$titan_dir" ] || continue
    local titan; titan=$(basename "$titan_dir")
    while IFS= read -r f; do
      base=$(basename "$f")
      slug=$(slugify "$base"); [ -z "$slug" ] && slug="line"
      # manifest override (semantic, from build_manifest.py) wins; else keyword classify()
      bucket=$(manifest_bucket "$titan" "$slug") || bucket=$(classify "$(echo "$base" | tr '[:upper:]' '[:lower:]')")
      mkdir -p "$titan_dir$bucket"
      dest="$titan_dir$bucket/$slug.wav"; n=1
      while [ -e "$dest" ]; do dest="$titan_dir$bucket/$slug-$n.wav"; n=$((n+1)); done
      mv "$f" "$dest" && moved=$((moved+1))
    done < <(find "$titan_dir" -maxdepth 1 -iname '*.wav' 2>/dev/null)
  done
  echo "normalized: $moved files bucketed"
}

cmd_test() { cmd_play "${1:-notify}"; }

cmd_log() { # log [n] — last n rows (default 20); log clear — truncate; log off/on — toggle key
  case "${1:-}" in
    clear) : > "$LOGFILE"; echo "log cleared" ;;
    off)   cfg_set log 0; echo "log: OFF" ;;
    on)    cfg_set log 1; echo "log: ON" ;;
    *)
      [ -s "$LOGFILE" ] || { echo "(log empty)"; return; }
      { printf 'WHEN\tEVENT\tTITAN\tBUCKET\tWAV\tPROJECT\n'; tail -n "${1:-20}" "$LOGFILE"; } | column -t -s "$(printf '\t')" ;;
  esac
}

cmd_level() { # loudness-normalize every wav in place to config loudness (EBU R128, one-time)
  command -v ffmpeg >/dev/null 2>&1 || die "ffmpeg required (brew install ffmpeg)"
  local target n=0 fail=0 f tmp; target=$(cfg loudness -18)
  tmp="${TMPDIR:-/tmp}/titancall-lvl.$$.wav"      # temp outside the library (in-dir temp proved flaky)
  echo "leveling library to ${target} LUFS (this takes a minute)..."
  while IFS= read -r f; do
    if ffmpeg -y -i "$f" -af "loudnorm=I=${target}:TP=-1.5:LRA=11" -ar 44100 "$tmp" >/dev/null 2>&1 && [ -s "$tmp" ]; then
      cp "$tmp" "$f"; n=$((n+1)); [ $((n % 50)) -eq 0 ] && err "...$n"
    else fail=$((fail+1)); fi
  done < <(find "$SOUNDS" -iname '*.wav')
  rm -f "$tmp"
  echo "leveled $n files${fail:+, $fail failed} to ${target} LUFS"
}

cmd_enable()  { cfg_set enabled 1; echo "titancall: ENABLED"; confirm "$(active_titan)" enter; }
cmd_disable() { cfg_set enabled 0; echo "titancall: MUTED (hooks fire but stay quiet)"; }
cmd_toggle()  { [ "$(cfg enabled 1)" = "0" ] && cmd_enable || cmd_disable; }
cmd_status()  {
  resolve_titan
  echo "state:  $([ "$(cfg enabled 1)" = "0" ] && echo MUTED || echo enabled)"
  echo "titan:  $ACTIVE_TITAN  (via $ACTIVE_SRC)"
  echo "output: $(cfg output 'system default')   volume: $(cfg volume 0.7)"
}

cmd_buckets() { bucket_names; }     # machine-readable bucket list (UI + completions read this)

cmd_playfile() { # playfile <wav> [event] — play one exact file: preview for `titancall ui`.
  # Explicit user action, so it bypasses the mute gate and cooldown; honors output device + volume.
  local f="${1:-}"; [ -n "$f" ] || die "usage: titancall playfile <wav> [event]"
  [ -f "$f" ] || die "no such wav: $f"
  play_file "$f" "${2:-}"
}

cmd_review() { # review [apply] — dump the whole library to an editable CSV, then fold edits back
  local mf="$REPO_DIR/scripts/build_manifest.py"
  [ -f "$mf" ] || die "missing $mf"
  command -v python3 >/dev/null 2>&1 || die "titancall review needs python3 (playback does not)"
  case "${1:-}" in
    ""|export|show) python3 "$mf" --review ;;          # refuses to clobber unapplied edits
    -f|--force)     python3 "$mf" --review --force ;;  # discard them deliberately
    apply|import)   python3 "$mf" --import-review ;;
    *) die "usage: titancall review [apply | --force]" ;;
  esac
}

cmd_ui() { # curses console for wiring wavs -> buckets -> groups -> events (the only python3 path)
  local ui="$REPO_DIR/scripts/titancall_ui.py"
  [ -f "$ui" ] || die "missing $ui"
  command -v python3 >/dev/null 2>&1 || die "titancall ui needs python3 (the rest of titancall does not)"
  exec python3 "$ui" "$@"
}

# ---- shell completion (thin bash/zsh scripts call `titancall __complete`; candidates stay live) ----
SUBCOMMANDS="play random whoami roster titan output volume cooldown lines normalize level config alias group project buckets review test log ui on off toggle status help"
events()       { grep -E '^alias\.' "$CONFIG" 2>/dev/null | sed -E 's/^alias\.([^=]+)=.*/\1/'; }
device_names() { have_switch && SwitchAudioSource -a -t output 2>/dev/null; }

cmd_complete() { # args = completed words before the cursor; emit newline candidates for that slot
  local n=$# sub="${1:-}"
  if [ "$n" -le 0 ]; then                        # bare `titancall <TAB>`: commands + playables
    printf '%s\n' $SUBCOMMANDS; events; target_names; return
  fi
  case "$sub" in
    titan)
      if [ "$n" -eq 1 ]; then printf 'list\nhere\nshow\n'; list_titans
      elif [ "$2" = here ] && [ "$n" -eq 2 ]; then list_titans; fi ;;
    roster)
      if [ "$n" -eq 1 ]; then printf 'list\nprune\nforget\n'
      elif [ "$2" = forget ] && [ "$n" -le 3 ]; then [ "$n" -eq 2 ] && printf -- '--purge\n'; reg_paths; reg_used
      elif [ "$2" = prune ] && [ "$n" -eq 2 ]; then printf -- '-n\n'; fi ;;
    play|test|random|lines)
      [ "$n" -eq 1 ] && { events; target_names; } ;;
    output)
      [ "$n" -eq 1 ] && { printf 'list\ndefault\n'; device_names; } ;;
    config)
      if [ "$n" -eq 1 ]; then printf 'get\nset\nunset\n'
      elif { [ "$2" = get ] || [ "$2" = set ] || [ "$2" = unset ]; } && [ "$n" -eq 2 ]; then
        printf '%s\n' $CONFIG_KEYS
        local e; for e in $(events); do printf 'alias.%s\nvolume.%s\ncooldown.%s\n' "$e" "$e" "$e"; done
      fi ;;
    alias)
      if [ "$n" -eq 1 ]; then events
      elif [ "$n" -eq 2 ]; then target_names; fi ;;
    project)
      if [ "$n" -eq 1 ]; then printf 'show\nalias\ngroup\nset\nunset\n'
      elif [ "$2" = alias ] && [ "$n" -eq 2 ]; then events
      elif [ "$2" = alias ] && [ "$n" -eq 3 ]; then target_names
      elif [ "$2" = group ] && [ "$n" -eq 3 ]; then bucket_names
      elif { [ "$2" = set ] || [ "$2" = unset ]; } && [ "$n" -eq 2 ]; then
        printf '%s\n' $CONFIG_KEYS
        local e; for e in $(events); do printf 'alias.%s\nvolume.%s\ncooldown.%s\n' "$e" "$e" "$e"; done
      fi ;;
    group)
      if [ "$n" -eq 1 ]; then printf 'list\nshow\nset\nrm\n'
      elif { [ "$2" = show ] || [ "$2" = rm ]; } && [ "$n" -eq 2 ]; then group_names
      elif [ "$2" = set ] && [ "$n" -ge 3 ]; then bucket_names; fi ;;
    review)
      [ "$n" -eq 1 ] && printf 'apply\n--force\n' ;;
    log)
      [ "$n" -eq 1 ] && printf 'on\noff\nclear\n' ;;
    *) : ;;                                       # volume/cooldown freeform; on/off/etc. terminal
  esac
}

usage() {
  cat <<EOF
titancall — TF2 Titan voice notifications, one voice per project

  titancall <event>            play event for this project's titan
  titancall play <event>       events: done success error fatal warn start notify working idle
                               buckets: down core damage eject warn enter follow attack guard exit misc
  titancall random <event>     play from a random titan
  titancall on | off | toggle  global mute switch (hooks stay quiet when off)
  titancall status             show enabled/muted + titan + output
  titancall whoami             show resolved titan + why, for current project
  titancall roster             list all registered project->titan + last fired
  titancall roster prune [-n]  drop rows whose project dir no longer exists (-n = preview)
  titancall roster forget [--purge] [x]
                               drop one row: <path>, <titan>, or bare = this project
                               --purge also drops the project's .titan identity line
  titancall titan list         list installed titans
  titancall titan here <name>  pin current project to <name> (writes ./.titan + registry)
  titancall titan <name>       set global default titan (config)
  titancall output list|NAME|default
  titancall volume [0..1]
  titancall cooldown [secs]    per-voice min gap; collapses bursts (0 = off). default 4
  titancall alias [<event> <bucket|group>]  list or remap event->bucket/group
  titancall group [list | show <n> | set <n> <b1,b2,...> | rm <n>]
                               named bucket sets; an alias on a group draws from any member
  titancall project [show | alias <e> <t> | group <n> <b,..> | set <k> <v> | unset <k>]
                               per-project overrides written into ./.titan (win over global config)
  titancall buckets            list bucket names (machine-readable)
  titancall ui                 curses console: wire wavs -> buckets -> groups -> events (needs python3)
  titancall review [apply]     dump whole library to data/review.csv (+gap report); 'apply' folds
                               your edited new_bucket column back and moves the wavs
  titancall lines [event]
  titancall normalize          bucket+rename installed wavs into <titan>/<event>/
  titancall level              loudness-normalize all wavs to config 'loudness' LUFS (one-time, needs ffmpeg)
  titancall config [get <k> | set <k> <v> | unset <k>] | test [event]
  titancall log [n]            show last n played (default 20): when/event/titan/bucket/wav/project
  titancall log on|off|clear   toggle playback logging (config 'log') or wipe the log file

playback is non-blocking (detached) so hooks never wait; set TITANCALL_WAIT=1 to block until the clip ends
resolution: \$TITANCALL_TITAN > ./.titan (walk up) > registry > claim next free titan
config:   $CONFIG
registry: $REGISTRY
log:      $LOGFILE
sounds:   $SOUNDS
EOF
}

main() {
  ensure_config
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    ""|help|-h|--help) usage ;;
    play)       cmd_play "$@" ;;
    random)     cmd_random "$@" ;;
    whoami)     cmd_whoami ;;
    roster)     cmd_roster "$@" ;;
    titan)      cmd_titan "$@" ;;
    output)     cmd_output "$@" ;;
    volume|vol) cmd_volume "$@" ;;
    cooldown)   cmd_cooldown "$@" ;;
    lines)      cmd_lines "$@" ;;
    normalize)  cmd_normalize "$@" ;;
    level)      cmd_level "$@" ;;
    config)     cmd_config "$@" ;;
    alias)      cmd_alias "$@" ;;
    group)      cmd_group "$@" ;;
    project)    cmd_project "$@" ;;
    buckets)    cmd_buckets ;;
    review)     cmd_review "$@" ;;
    playfile)   cmd_playfile "$@" ;;
    ui)         cmd_ui "$@" ;;
    test)       cmd_test "$@" ;;
    log)        cmd_log "$@" ;;
    on|enable)  cmd_enable ;;
    off|disable|mute) cmd_disable ;;
    toggle)     cmd_toggle ;;
    status)     cmd_status ;;
    __complete) cmd_complete "$@" ;;
    *)          cmd_play "$cmd" "$@" ;;
  esac
}
main "$@"
